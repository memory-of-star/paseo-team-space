{
  "name": "paseo-team-space",
  "version": "0.1.1",
  "description": "Share read-only agent conversations with a team and fork private local branches.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client",
    "server",
    "shared",
    "assets",
    "dist",
    "README.md",
    "OVERVIEW.md",
    "docs",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write client server shared service scripts tests index.* package.json paseo-plugin.json tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "build": "esbuild service/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/team-service.mjs",
    "start": "node dist/team-service.mjs",
    "dev:service": "tsx service/main.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@getpaseo/client": "0.15.4",
    "@getpaseo/plugin": "0.15.4",
    "@getpaseo/protocol": "0.15.4",
    "@tanstack/react-query": "^5.90.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "playwright": "^1.56.1",
    "prettier": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
